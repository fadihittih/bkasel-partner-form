# Copy to .env for local runs. On Hostinger, set these in hPanel -> Environment variables.

# Long random secret shared with the Android app (min 32 chars). Generate: openssl rand -hex 32
API_TOKEN=

# MySQL (Hostinger: hPanel -> Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternatively one URL instead of the DB_* values: mysql://user:pass@host:3306/dbname
# DATABASE_URL=

# Port to listen on (Hostinger passes its own; 3000 locally)
PORT=3000
